{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "isolatedModules": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "paths": {
      "@frontend/*": [
        "./src/astrophotoflow/frontend/*"
      ]
    }
  },
  "include": [
    "src/astrophotoflow/frontend/**/*.ts",
    "src/astrophotoflow/frontend/**/*.vue",
    "tests/frontend/**/*.ts"
  ]
}
