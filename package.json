{
  "name": "astrophotoflow",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.13.1",
  "engines": {
    "node": ">=26.8.2 <27",
    "pnpm": ">=11.3"
  },
  "scripts": {
    "docs:api": "uv run --locked --no-sync python scripts/export_openapi.py",
    "generate:sdk": "python scripts/export_openapi.py && pnpm --dir frontend --filter @astrophotoflow/ui exec openapi-ts -f openapi-ts.config.ts",
    "generate:database-baseline": "python scripts/generate_database_baseline.py",
    "benchmark:library": "python scripts/benchmark_library.py",
    "typecheck": "pnpm --dir frontend --filter @astrophotoflow/ui typecheck",
    "build": "python scripts/frontend_build_record.py",
    "dev:prepare": "python scripts/dev_prepare.py",
    "dev:mcp": "python scripts/dev_mcp.py",
    "build:watch": "python scripts/dev_frontend.py",
    "test": "pnpm --dir frontend --filter @astrophotoflow/ui test",
    "test:browser": "pnpm --dir frontend exec playwright test --config ../tests/browser/playwright.config.mjs",
    "test:watch": "pnpm --dir frontend --filter @astrophotoflow/ui test:watch",
    "check:boundaries": "python -m pytest tests/architecture -q && pnpm --dir frontend exec depcruise src/platform/astrophotoflow packages/astrophotoflow-ui/src --config .dependency-cruiser.json --do-not-follow \"node_modules|^src/(?!platform/astrophotoflow/)\" --output-type err-long",
    "check:docs": "python scripts/verify_docs.py all",
    "test:browser:modernization": "pnpm --dir frontend exec playwright test --config ../tests/browser/modernization.config.mjs",
    "test:browser:native": "pnpm --dir frontend exec playwright test --config ../tests/browser/modernization-native.config.mjs"
  }
}
